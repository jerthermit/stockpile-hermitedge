# Application
STOCKPILE_ENV=development
FRONTEND_URL=http://localhost:3000
STOCKPILE_AUTH_SECRET=replace-with-a-long-random-secret
STOCKPILE_BADGE_SECRET=replace-with-a-long-random-badge-secret
STOCKPILE_TOKEN_TTL_SECONDS=28800
STOCKPILE_TENANT_ID=stockpile-demo

# Database
# Leave both blank to use backend/inventory.db locally.
DATABASE_URL=
STOCKPILE_DB_PATH=

# Local demo data
STOCKPILE_SEED_DEMO_DATA=true

# Demo owner
STOCKPILE_ADMIN_USERNAME=owner
STOCKPILE_ADMIN_DISPLAY_NAME=Ana Reyes
STOCKPILE_ADMIN_PASSWORD=stockpile-owner-demo
STOCKPILE_ADMIN_BADGE_CODE=OWN-1001
STOCKPILE_ADMIN_BADGE_PIN=4826

# Demo staff member
STOCKPILE_OPERATOR_USERNAME=staff
STOCKPILE_OPERATOR_DISPLAY_NAME=Miguel Santos
STOCKPILE_OPERATOR_PASSWORD=stockpile-staff-demo
STOCKPILE_OPERATOR_BADGE_CODE=STF-2042
STOCKPILE_OPERATOR_BADGE_PIN=7314

# Product images
# Set this to a mounted Railway volume in production.
STOCKPILE_PRODUCT_IMAGE_DIR=

# AI review
TOGETHER_API_KEY=
TOGETHER_AI_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
TOGETHER_AI_VISION_MODEL=Qwen/Qwen3.5-9B
TOGETHER_AI_TIMEOUT_SECONDS=45
